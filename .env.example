# Fine-grained GitHub personal access token.
# IMPORTANT: use a fine-grained PAT scoped to ONLY the repos listed in ALLOWED_REPOS.
# Required permissions: Contents = Read and write, Pull requests = Read and write.
GITHUB_TOKEN=

# Default repo (used when tools are called without a repo override).
GITHUB_OWNER=your-username-or-org
GITHUB_REPO=your-content-repo

# Comma-separated list of repos this server is allowed to touch.
# The default repo is always included even if omitted here.
ALLOWED_REPOS=your-username-or-org/your-content-repo

# Folder inside the repo that holds the .md content (relative path, no leading slash).
CONTENT_DIR=content

# Branch that write operations open pull requests against.
BASE_BRANCH=main

# --- Authentication ---
# Option 1 (recommended): per-user API keys with access levels.
# JSON array: [{"label":"alice","key":"<random>","access":"readwrite"}, ...]
# Generate keys with: openssl rand -hex 32
# Access levels: "read" (list + read only) or "readwrite" (all operations).
MCP_API_KEYS=

# Option 2 (simple, backwards compatible): single shared token, full access.
# Only used if MCP_API_KEYS is not set.
# MCP_ACCESS_TOKEN=

# Port the HTTP server listens on (most hosts inject this automatically).
PORT=3000
