{
  "name": "md-cms-mcp-server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Stripped-down MCP server that lets an AI assistant (Claude, ChatGPT) read and edit Markdown content files in a GitHub repo via a branch + pull request flow.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@octokit/rest": "^21.0.2",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
